{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expanso.io/schemas/public-features-v1.json",
  "title": "Retained public demo features",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "features", "routes", "controls", "downloads",
    "browser_assertions"
  ],
  "properties": {
    "version": {"const": 1},
    "features": {"$ref": "#/$defs/described"},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/item"},
          {
            "type": "object",
            "required": ["path"],
            "properties": {"path": {"type": "string", "minLength": 1}}
          }
        ]
      }
    },
    "controls": {"$ref": "#/$defs/selected"},
    "downloads": {"$ref": "#/$defs/selected"},
    "browser_assertions": {"$ref": "#/$defs/described"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "item": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}}
    },
    "described": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/item"},
          {
            "type": "object",
            "required": ["description"],
            "properties": {"description": {"type": "string", "minLength": 1}}
          }
        ]
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/item"},
          {
            "type": "object",
            "required": ["selector"],
            "properties": {"selector": {"type": "string", "minLength": 1}}
          }
        ]
      }
    }
  }
}
